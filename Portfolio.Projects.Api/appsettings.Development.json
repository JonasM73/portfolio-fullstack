{
  "MongoDb": {
    "DatabaseName": "portfolio-db",
    "ProjectsCollection": "projects"
  },
  "Jwt": {
    "Issuer": "Portfolio.Auth.Api",
    "Audience": "Portfolio.Admin"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AzureBlobStorage": {
    "ContainerName": "portfolio-projects"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  }
}